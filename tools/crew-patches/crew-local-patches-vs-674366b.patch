@@ -1986,6 +1986,34 @@ def rework_fails(card_id):
 PROOF_BLOCKED = 5       # `verdict` exit code: the safety floor refused the proof, nothing ran, no verdict line
 
 
+def _proof_cwd(card):
+    """The directory a proof runs in: the card's own workspace, so a verifier runs the proof where the work is.
+
+    None (the old behaviour: the caller's cwd) only when the card has no usable workspace path.
+    """
+    try:
+        db = kanban_db()
+        if not db:
+            return None
+        conn = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
+        try:
+            row = conn.execute("select workspace_path from tasks where id=?", (card,)).fetchone()
+        finally:
+            conn.close()
+        path = row[0] if row else None
+        if path and os.path.isdir(path):
+            return path
+        # A scratch card has no workspace path: fall back to the board's default workdir (board.json next to
+        # the board DB), so every verifier still runs the proof in the project rather than in its own cwd.
+        import json as _json
+        meta = os.path.join(os.path.dirname(db), "board.json")
+        with open(meta, encoding="utf-8") as fh:
+            board_dir = (_json.load(fh) or {}).get("default_workdir") or ""
+        return board_dir if board_dir and os.path.isdir(board_dir) else None
+    except Exception:  # noqa: BLE001 - a lookup that fails must not stop the proof
+        return None
+
+
